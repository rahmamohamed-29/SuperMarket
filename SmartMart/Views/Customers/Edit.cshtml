@model Customer
<section class="pb-5">
    <div class="container">
        <div class="text-center">
            <h1 class="text-black fw-bold fs-1 mt-5">Edit Customer</h1>
            <p>Update customer information.</p>
        </div>
        <div class="w-75 mx-auto p-5 " style="box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;">
            <h3 class="text-black fw-bold fs-2 mb-4"> <i class="bi bi-plus-circle-fill text-primary fw-bold"></i>Customer Information</h3>
            <form asp-controller="Customers" asp-action="EditCurrent" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input asp-for="ImagePath" type="hidden" />
                <div class="form-group mb-3">
                    <label class="form-label" asp-for="ImageFile"></label>
                    <input type="file" class="form-control" asp-for="ImageFile" accept=".png,.jpg,.jpeg" id="imageFileInput" onchange="addPreviewImage()" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <img src="@Model.ImagePath" id="CustomerImage" style="object-fit:contain;" class="w-50 mx-auto" alt="Customer Image" />

                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Name"></label>
                    <input asp-for="Name" class="form-control p-3 text-black fs-5"  />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Email"></label>
                    <input asp-for="Email" class="form-control p-3 text-black fs-5"  />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Phone"></label>
                    <input asp-for="Phone" class="form-control p-3 text-black fs-5"  />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="City"></label>
                    <input asp-for="City" class="form-control p-3 text-black fs-5"  />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Address"></label>
                    <input asp-for="Address" class="form-control p-3 text-black fs-5"  />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>



                <button type="submit" class="btn btn-primary fw-bold fs-5 px-3 me-4">Edit</button>
                <a asp-controller="Customers" asp-action="Index" class="btn btn-secondary fw-bold fs-5 px-3">Cancel</a>
            </form>

        </div>
    </div>
</section>

@section Scripts {
    <script>
        let customerImage = document.getElementById('CustomerImage');
        let imageFileInput = document.getElementById('imageFileInput');
        if (!customerImage.getAttribute('src')) {
            customerImage.style.display = 'none';
        }

        function addPreviewImage() {
            customerImage.style.display = 'block';
            customerImage.src = window.URL.createObjectURL(imageFileInput.files[0]);
        }
    </script>
}
