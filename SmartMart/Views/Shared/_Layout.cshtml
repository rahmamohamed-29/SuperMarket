<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartMart</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartMart.styles.css" asp-append-version="true" />
    <link href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/bootminty.min.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-primary border-bottom box-shadow  ">
            <div class="container">
                <a class="navbar-brand fs-2 fw-semibold text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-cart4"></i> SmartMart</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">
                    <ul class="navbar-nav ">
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5 fw-medium" asp-area="" asp-controller="Home" asp-action="Index"> <i class="bi bi-house-door-fill"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5 fw-medium" asp-area="" asp-controller="Categories" asp-action="Index"> <i class="bi bi-tag-fill"></i> Categories</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5 fw-medium" asp-area="" asp-controller="Products" asp-action="Index"> <i class="bi bi-box-fill"></i> Products</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fs-5 fw-medium" asp-area="" asp-controller="Customers" asp-action="Index"> <i class="bi bi-people-fill"></i> Customers</a>
                        </li>
                       
                       
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div >
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-5">
        <div class="container">
            
              
                <div class="text-center"> &copy; 2026 SmartMart &hearts;, All rights reserved.</div>
            

            @* &copy; 2026 - SmartMart - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a> *@
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
