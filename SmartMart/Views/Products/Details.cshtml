@model Product
<section class=" pb-5">
    <div class="container">
        <div class=" mx-auto p-5 " style="box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;">
            
           <input type="hidden" asp-for="Id" />
           <h2 class="text-black fw-bold fs-1">Product Details</h2>
           <p class="text-dark fs-4">View all information about this product.</p>
           <div class="row justify-content-between">
                <img src="@Model.ImagePath" alt="@Model.Name" class="rounded col-5" style=" object-fit: contain;" />
                    <div class="col-7">
                        <h3 class="text-black fw-bold fs-2">@Model.Name</h3>
                    <p class="stock rounded-3 text-white p-2 text-center fs-6 fw-bold " style="display: inline-block !important; width: fit-content !important;"><i class="bi bi-circle-fill"></i> @Model.StockStatus</p>
                     <div class="row g-2 justify-content-between">
                        <div class="col-6 row alert alert-primary align-items-center">
                            <div class="col-4 text-white rounded-circle d-flex justify-content-center align-items-center bg-primary mb-3" style="width: 50px; height: 50px; "><i class="bi bi-tag-fill fs-3 fw-bold"></i></div>
                        <div class="col-8">
                            <h4 class="fw-bold text-black">Category:</h4>
                            <p class ="fs-5 text-dark">@Model.Category.Name</p>
                        </div>
                        </div>
                        <div class="col-6 row alert alert-primary align-items-center">
                        <div class="col-4 text-white rounded-circle d-flex justify-content-center align-items-center bg-primary mb-3" style="width: 50px; height: 50px; "><i class="bi bi-currency-dollar fs-3 fw-bold"></i></div>
                        <div class="col-8">
                            <h4 class="fw-bold text-black">Price:</h4>
                            <p class="fs-5 text-dark">@Model.Price.ToString("F2") EGP</p>
                        </div>
                        </div>
                        <div class="col-6 row alert alert-primary align-items-center">
                            <div class="col-4 text-white rounded-circle d-flex justify-content-center align-items-center bg-primary mb-3" style="width: 50px; height: 50px; "><i class="bi bi-box-seam-fill fs-3 fw-bold"></i></div>
                        <div class="col-8">
                            <h4 class="fw-bold text-black">Stock:</h4>
                            <p class="fs-5 text-dark">@Model.AvailableStock items</p>
                        </div>
                        </div>
                        <div class="col-6 row alert alert-primary align-items-center">
                            <div class="col-4 text-white rounded-circle d-flex justify-content-center align-items-center bg-primary mb-3" style="width: 50px; height: 50px; "><i class="bi bi-upc-scan fs-3 fw-bold"></i></div>
                        <div class="col-8">
                            <h4 class="fw-bold text-black">Product Id:</h4>
                            <p class="fs-5 text-dark">@Model.productId</p>
                        </div>
                        </div>
                        <div class="col-12 row alert alert-primary align-items-center w-100">
                            <div class="col-4 text-white rounded-circle d-flex justify-content-center align-items-center bg-primary mb-3" style="width: 50px; height: 50px; "><i class="bi bi-file-earmark-text-fill fs-3 fw-bold"></i></div>
                        <div class="col-8">
                            <h4 class="fw-bold text-black">Description:</h4>
                            <p class="fs-5 text-dark">@Model.Description</p>
                        </div>
                        </div>


                       
                    </div>
      
                    </div>
           </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary fw-bold fs-5 px-3"> <i class="bi bi-arrow-left"></i> Back to Products</a>
          
        </div>
    </div>
</section>


@section Scripts {
    <script>
        let StockStatuses = document.querySelectorAll('.stock');
        StockStatuses.forEach(function(StockStatus) {
            let stockText = StockStatus.textContent.trim();
            switch (stockText) {
                case 'In Stock':
                    StockStatus.style.backgroundColor = 'rgba(76, 175, 80, 0.5)';
                    break;
                case 'Low Stock':
                    StockStatus.style.backgroundColor = 'rgba(255, 193, 102, 0.5)';
                    break;
                case 'Out of Stock':
                    StockStatus.style.backgroundColor = 'rgba(239, 149, 153, 0.5)';
                    break;
            }
        });

    </script>
}


