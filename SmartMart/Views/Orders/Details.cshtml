@model SmartMart.ViewModel.DetailsOrder
<section>
    <div class="container">
        <div class="d-flex flex-column mb-4">

            <div>
                <p class="text-primary fw-semibold mb-1"> ORDER ITEMS</p>
                <h2 class="text-black fw-bold mb-2">Products in this Order</h2>
                <p class="text-muted mb-0"> View the products, quantities, and prices included in this order. </p>
            </div>
            <div class="mt-3 px-4 py-1 rounded-4 shadow-sm" style="background-color:#E4F3EF; width:fit-content;">
                  <p class="text-primary fw-bold mb-1 fs-6">Total Items : @Model.OrderItems.Count</p>
            </div>
        </div>

        <div class="row g-4 py-5">

            @foreach (var orderitem in Model.OrderItems)
            {
                <div class="col-lg-4 col-md-6 col-sm-12">

                    <div class="p-4 rounded-4 h-100" style="box-shadow: rgba(0, 0, 0, 0.08) 0px 4px 15px;">
                       
                        
                            <div class="d-flex align-items-center mb-3">
                            <img src="@orderitem.Product.ImagePath" class="mx-auto" style="height:220px;" alt="@orderitem.Product.Name" />
                            </div>
                            <div class=" mb-3">
                                <h3 class="text-black fw-semibold">@orderitem.Product.Name</h3>
                                <p class="categoryName rounded-3 text-white px-2 py-1 fw-bold fs-6 " style="display: inline-block !important; width: fit-content !important;">@orderitem.Product.Category.Name</p>                            
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-cart4 text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Quantity</small>
                                    <span class="fw-semibold"> @orderitem.Quantity </span>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3">
                                <i class="bi bi-coin text-primary me-3 fs-5"></i>
                                <div>
                                    <small class="text-muted d-block">Price</small>
                                    <span class="fw-bold text-primary"> @orderitem.Price EGP </span>
                                </div>
                            </div>

                       
                       

                    </div>

                </div>
            }

        </div>

    </div>
</section>
@section Scripts {
    <script>
        let CategoryNames = document.querySelectorAll('.categoryName');
        CategoryNames.forEach(function(CategoryName) {
            let categoryText = CategoryName.textContent.trim();
            switch (categoryText) {
                case 'Fruits & Vegetables':
                    CategoryName.style.backgroundColor = 'rgba(76, 175, 80, 0.5)';
                    break;
                case 'Dairy & Eggs':
                    CategoryName.style.backgroundColor = 'rgba(64, 172, 160, 0.5)';
                    break;
                case 'Meat & Poultry':
                    CategoryName.style.backgroundColor = 'rgba(239, 149, 153, 0.5)';
                    break;
                case 'Bakery':
                    CategoryName.style.backgroundColor = 'rgba(255, 193, 102, 0.5)';
                    break;
                case 'Snacks':
                    CategoryName.style.backgroundColor = 'rgba(153, 102, 255, 0.5)';
                    break;
                case 'Frozen Foods':
                    CategoryName.style.backgroundColor = 'rgba(92, 160, 220, 0.5)';
                    break;
                default:
                    CategoryName.style.backgroundColor = 'rgba(201, 203, 207, 0.5)';
            }
        });

    </script>
}
