@model Category
<section class="pb-5">
    <div class="container">
        <div class="text-center">
            <h1 class="text-black fw-bold fs-1 mt-5"> Edit Category</h1>
            <p>Update your category information.</p>
        </div>
        <div class="w-75 mx-auto p-5 " style="box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;">
            <h3 class="text-black fw-bold fs-2 mb-4"><span class="bg-primary text-white rounded-circle d-inline-flex justify-content-center align-items-center" style="width: 50px; height: 50px;"><i class="bi bi-pen fs-2"></i></span>  Edit Category</h3>
            <form asp-controller="Categories" asp-action="EditCurrent" method="post" >
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Name"></label>
                    <input asp-for="Name" class="form-control p-3 text-black fs-5" placeholder="Enter category name...." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control p-3 text-black fs-5" rows="5" placeholder="Enter category description...."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary fw-bold fs-5 px-3 me-4">Edit</button>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-secondary fw-bold fs-5 px-3">Cancel</a>
            </form>
        </div>
    </div>
</section>
