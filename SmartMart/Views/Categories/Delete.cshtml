@model Category
<section class="pb-5">
    <div class="container">
        <div class="text-center">
            <h1 class="text-black fw-bold fs-1 mt-5">Delete Category</h1>
            <p>Please confirm that you want to delete this category.</p>
        </div>
        <div class="w-75 mx-auto p-5 " style="box-shadow: gba(0, 0, 0, 0.1) 0px 4px 12px;">
            <div class="row justify-content-center text-center">
                <div class="text-white rounded-circle d-flex justify-content-center align-items-center bg-secondary mb-3" style="width: 100px; height: 100px; "><i class="bi bi-trash fs-1"></i></div>
                <h3 class="text-black fw-bold fs-2 mb-4"> Are you sure?</h3>
                <p>You are about to delete the category</p>
            </div>
            <div class="alert alert-secondary">
                <dl>
                    <dt class="fw-bold text-black">Name</dt>
                    <dd class="fs-4 text-dark">@Model.Name</dd>
                     <dt class="fw-bold text-black">Description</dt>
                    <dd class="fs-4 text-dark">@Model.Description</dd>
                </dl>
            </div>
            <div class="row justify-content-center">
                <form asp-controller="Categories" asp-action="DeleteCurrent" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-secondary fw-bold fs-5 px-3">Delete</button>
                    <a asp-controller="Categories" asp-action="Index" class="btn btn-light  fw-bold fs-5 px-3">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</section>
