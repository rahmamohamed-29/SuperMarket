@model Category
<section class="pb-5">
<div class="container">
    <div class="text-center">
            <h1 class="text-black fw-bold fs-1 mt-5">Add New Category</h1>
            <p>Create a new category for your products.</p>
    </div>
    <div class="w-75 mx-auto p-5 " style="box-shadow: rgba(0, 0, 0, 0.1) 0px 4px 12px;">
            <h3 class="text-black fw-bold fs-2 mb-4"> <i class="bi bi-plus-circle-fill text-primary fw-bold"></i>  Category Information</h3>

            
            <form asp-controller="Categories" asp-action="AddNew" method="post" >
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Name"></label>
                    <input asp-for="Name" class="form-control p-3 text-black fs-5" placeholder="Enter category name...." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label class="form-label text-black fs-4" asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control p-3 text-black fs-5" rows="5" placeholder="Enter category description...."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary fw-bold fs-5 px-3">Create</button>
            </form>
    </div>
</div>
</section>